{
  "manifest_version": 3,
  "name": "Corn Downloader",
  "version": "0.8.0",
  "description": "Private local HLS and direct MP4 video detector and downloader.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "tabs",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js",
      "direct.js"
    ]
  },
  "action": {
    "default_title": "Corn Downloader",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "corn-downloader@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
