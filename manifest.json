{
  "manifest_version": 3,
  "name": "Corn Downloader",
  "version": "0.8.1",
  "description": "Detect and download supported HLS streams and direct MP4 videos.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "tabs",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js",
      "direct.js"
    ]
  },
  "action": {
    "default_title": "Corn Downloader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/corn-48.png",
      "96": "icons/corn-96.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "corn-downloader@local",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "authenticationInfo"
        ]
      },
      "strict_min_version": "142.0"
    }
  },
  "homepage_url": "https://github.com/StiffyTime/CornDownloader",
  "icons": {
    "48": "icons/corn-48.png",
    "96": "icons/corn-96.png"
  }
}
